---
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import GalleryButton from '../components/GalleryButton.astro';
import concept from '../assets/platform-concept.svg';
import { url } from '../data/site';

const home = url();
const farm = (await getCollection('updates')).find((u) => u.id.includes('hoffmans'))!;
const farmCover = farm.data.photos[1];
const ogImage = (await getImage({ src: farmCover.src, width: 1200, format: 'jpg' })).src;

const status = [
  { label: 'Project', value: 'Modular agricultural robotics' },
  { label: 'Application under study', value: 'Greenhouse crop care' },
  { label: 'Near-term goal', value: 'A testable, limited-scope prototype' },
];

const questions = [
  {
    title: 'What actually takes time?',
    body: 'Understand recurring tasks, current tools, and the labour involved in completing an entire growing row.',
  },
  {
    title: 'What does a good result look like?',
    body: 'Define acceptable crop handling, cutting quality, and when a task needs human judgement.',
  },
  {
    title: 'What fits the farm?',
    body: 'Measure working heights, aisle access, rails, and the routines the robot would need to work within.',
  },
];

const system = [
  {
    tag: '01 / Mechanical',
    title: 'Mobile platform',
    body: 'A compact base designed around the terrain, crop access, and stability required by the chosen task.',
  },
  {
    tag: '02 / Hardware',
    title: 'Power & interfaces',
    body: 'Motor control, power distribution, sensor connections, and dependable low-level operation.',
  },
  {
    tag: '03 / Perception',
    title: 'Visual understanding',
    body: 'Camera-based observation and target localisation, tested against real lighting and occlusion.',
  },
  {
    tag: '04 / Control',
    title: 'Movement & task control',
    body: 'Positioning, controlled motion, and coordination between the platform and a task-specific tool.',
  },
];

const roadmap = [
  {
    tag: '01 / Discover',
    title: 'Listen & define',
    body: 'Visit farms, record the current workflow, and choose a bounded task with a clear baseline.',
    active: true,
  },
  {
    tag: '02 / Design',
    title: 'Build & bench-test',
    body: 'Develop the platform and task module. Measure positioning, repeatability, and tool behaviour.',
  },
  {
    tag: '03 / Integrate',
    title: 'Connect the system',
    body: 'Bring sensing, controls, and hardware together in a limited, repeatable test environment.',
  },
  {
    tag: '04 / Evaluate',
    title: 'Test & learn',
    body: 'Compare supervised robot operation with the existing workflow and document what still needs work.',
  },
];

const measures = [
  'Task completion',
  'Time per target',
  'Human intervention',
  'Crop handling quality',
  'Maintenance time',
  'Net labour input',
];
---

<Layout
  title="Agricultural Robotics Project — SPAIS"
  description="Explore SPAIS’s first agricultural robotics project: a modular mobile platform shaped by real farm needs. Discover our concept, research questions, and prototype goals."
  current="project"
  image={ogImage}
  footerNote={{ label: 'Learn. Build. Make it matter.', href: `${home}#join` }}
>
  <!-- Hero -->
  <section class="bg-pale pb-14 pt-8 md:pb-20 md:pt-10">
    <div class="wrap">
      <a
        href={home}
        class="mb-10 inline-flex flex-wrap items-center gap-x-3 gap-y-1 text-[12px] text-silver-500 transition-colors hover:text-ink md:mb-14"
      >
        <span aria-hidden="true">←</span> Back to SPAIS <span class="text-silver-300">/</span> Our first engineering project
      </a>

      <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
        <div data-reveal>
          <span class="pill bg-white"><span class="dot"></span>Discovery & concept development</span>
          <h1 class="display-xl mb-7 mt-6">
            Better crop care.<br />Built from<br /><em class="not-italic text-silver-500">real needs.</em>
          </h1>
          <p class="max-w-[480px] text-[15px] leading-[1.9] text-muted md:text-base">
            We’re developing the foundations of a modular agricultural robot—starting with growers’
            experience, a small mobile platform, and a carefully defined task.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a class="btn btn-dark" href={`${home}#growers`}>Help shape the project <span aria-hidden="true">↗</span></a>
            <a class="btn btn-outline" href="#roadmap">See our approach <span aria-hidden="true">↓</span></a>
          </div>
        </div>

        <figure
          class="relative flex min-h-[280px] items-center justify-center overflow-hidden rounded-xl bg-silver-100 md:min-h-[380px]"
          data-reveal
          style="--reveal-delay: 120ms"
        >
          <span class="absolute left-5 top-5 text-[10px] tracking-[0.14em] text-silver-500 md:left-6 md:top-6">
            PROPOSED SYSTEM / 001
          </span>
          <Image
            src={concept}
            alt="Proposed mobile robotics platform with a camera and interchangeable arm-mounted task tool."
            class="h-auto w-full"
            loading="eager"
          />
          <figcaption class="absolute inset-x-5 bottom-5 text-[10px] leading-relaxed text-silver-500 md:inset-x-6">
            Illustrative concept · Hardware and configuration to be validated
          </figcaption>
        </figure>
      </div>

      <dl class="mt-12 grid gap-4 border-t border-silver-200 pt-6 sm:grid-cols-3 sm:gap-8 md:mt-16" data-reveal>
        {
          status.map((s) => (
            <div class="flex items-baseline justify-between gap-5 sm:block">
              <dt class="text-[10px] uppercase tracking-[0.12em] text-silver-500 sm:mb-2">{s.label}</dt>
              <dd class="text-right text-[13px] font-medium sm:text-left">{s.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- The problem -->
  <section class="py-20 md:py-28">
    <div class="wrap grid gap-12 lg:grid-cols-2 lg:gap-24">
      <div data-reveal>
        <div class="eyebrow">Start with the problem</div>
        <h2 class="display-lg">A useful robot starts<br class="hidden sm:block" /> with a good question.</h2>
        <p class="mt-7 text-[15px] leading-[1.95] text-muted">
          Crop care combines repetitive work with delicate decisions. A useful robot has to fit the crop,
          the growing space, and the people working around it.
        </p>
        <p class="mt-5 text-[15px] leading-[1.95] text-muted">
          One candidate task is tomato leaf removal, with targeted wound protection when appropriate.
          We’re evaluating this direction alongside the practical requirements of the mobile platform.
          The final task will be shaped by grower input and early testing.
        </p>
      </div>
      <ol class="self-center">
        {
          questions.map((q, i) => (
            <li
              class="grid grid-cols-[36px_1fr] gap-4 border-t border-line py-6 last:border-b"
              data-reveal
              style={`--reveal-delay: ${i * 90}ms`}
            >
              <span class="pt-1 text-[12px] tabular-nums text-silver-400">0{i + 1}</span>
              <div>
                <h3 class="mb-2 text-lg font-semibold tracking-tight">{q.title}</h3>
                <p class="text-[14px] leading-[1.8] text-muted">{q.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- The system -->
  <section class="bg-pale py-20 md:py-28">
    <div class="wrap">
      <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end md:gap-12" data-reveal>
        <div>
          <div class="eyebrow">The platform we’re exploring</div>
          <h2 class="display-lg">One system.<br />Four connected disciplines.</h2>
        </div>
        <p class="max-w-[360px] text-[14px] leading-[1.8] text-muted">
          A modular architecture lets us test each part, learn from it, and bring the pieces together.
        </p>
      </div>

      <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          system.map((s, i) => (
            <article
              class="rounded-xl border border-silver-200 bg-white p-6 transition-shadow duration-300 hover:shadow-[0_12px_40px_#0000000f]"
              data-reveal
              style={`--reveal-delay: ${i * 80}ms`}
            >
              <span class="text-[10px] uppercase tracking-[0.12em] text-silver-500">{s.tag}</span>
              <h3 class="mb-3 mt-5 text-lg font-semibold tracking-tight">{s.title}</h3>
              <p class="text-[14px] leading-[1.85] text-muted">{s.body}</p>
            </article>
          ))
        }
      </div>

      <div
        class="mt-8 flex flex-col gap-2 rounded-xl border-l-2 border-silver-400 bg-silver-100 px-6 py-5 md:flex-row md:items-center md:gap-6"
        data-reveal
      >
        <strong class="shrink-0 text-[13px] font-semibold">Research direction, not a product claim.</strong>
        <p class="text-[13px] leading-[1.8] text-muted">
          Autonomy, task completion, labour savings, and crop benefits will need to be measured. Any
          wound-treatment function depends on an appropriate agronomic protocol.
        </p>
      </div>
    </div>
  </section>

  <!-- Roadmap -->
  <section id="roadmap" class="py-20 md:py-28">
    <div class="wrap">
      <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end md:gap-12" data-reveal>
        <div>
          <div class="eyebrow">From observation to evidence</div>
          <h2 class="display-lg">A focused path<br />to a first prototype.</h2>
        </div>
        <p class="max-w-[360px] text-[14px] leading-[1.8] text-muted">
          A four-month development goal, organised around learning milestones. Timing depends on access,
          resources, and test results.
        </p>
      </div>

      <ol class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6">
        {
          roadmap.map((r, i) => (
            <li
              class:list={[
                'border-t pt-6',
                r.active ? 'border-t-2 border-ink' : 'border-line',
              ]}
              data-reveal
              style={`--reveal-delay: ${i * 80}ms`}
            >
              <small class="text-[10px] uppercase tracking-[0.12em] text-silver-500">{r.tag}</small>
              <h3 class="mb-3 mt-4 text-lg font-semibold tracking-tight">{r.title}</h3>
              <p class="text-[14px] leading-[1.85] text-muted">{r.body}</p>
              {r.active ? (
                <span class="pill mt-5 border-ink/20 bg-ink text-white">
                  <span class="dot bg-accent" />
                  Current focus
                </span>
              ) : (
                <span class="pill mt-5 text-silver-500">Planned</span>
              )}
            </li>
          ))
        }
      </ol>

      <div
        class="mt-16 grid items-center gap-8 overflow-hidden rounded-2xl bg-pale p-5 md:mt-20 md:grid-cols-2 md:gap-14 md:p-8"
        data-reveal
      >
        <GalleryButton
          title={farm.data.albumTitle}
          source={farm.data.source}
          photos={farm.data.photos}
          start={1}
          label="Open photos from the Hoffman’s Strawberries visit"
          class="overflow-hidden rounded-xl"
        >
          <Image
            src={farmCover.src}
            alt="SPAIS members learning from their farm host during a field visit."
            widths={[480, 800]}
            sizes="(min-width: 768px) 50vw, 100vw"
            class="aspect-[1.4] w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
          />
          <span
            class="absolute bottom-3 right-3 rounded-full bg-white/90 px-3 py-1.5 text-[11px] text-ink backdrop-blur"
          >
            View {farm.data.photos.length} photos <span aria-hidden="true">↗</span>
          </span>
        </GalleryButton>
        <div>
          <div class="eyebrow">Learning before building</div>
          <h3 class="mb-4 text-[clamp(24px,2.4vw,30px)] font-medium leading-tight tracking-tight">
            Our classroom extends<br />to the field.
          </h3>
          <p class="mb-6 text-[14px] leading-[1.9] text-muted">
            Our October 23 visit to Hoffman’s Strawberries was an opportunity to ask questions and learn
            about the work behind food production. These conversations help us approach engineering with a
            better understanding of real needs.
          </p>
          <a class="text-link" href={farm.data.source} target="_blank" rel="noopener noreferrer">
            Read the visit recap <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Measures -->
  <section class="border-t border-line py-20 md:py-28">
    <div class="wrap grid gap-10 lg:grid-cols-2 lg:gap-24">
      <div data-reveal>
        <div class="eyebrow">What we want to measure</div>
        <h2 class="display-lg">Progress you can<br />put to the test.</h2>
      </div>
      <div data-reveal style="--reveal-delay: 100ms">
        <p class="text-[15px] leading-[1.95] text-muted">
          A successful demonstration is a starting point. We want to understand how the system performs
          across repeated tasks, how often it needs help, and whether it improves the overall workflow.
        </p>
        <ul class="mt-8 flex flex-wrap gap-2.5">
          {
            measures.map((m) => (
              <li class="rounded-full border border-line px-4 py-2 text-[12px] text-silver-600">{m}</li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="bg-deep py-16 text-white md:py-20">
    <div class="wrap flex flex-col justify-between gap-8 md:flex-row md:items-center md:gap-12" data-reveal>
      <div>
        <h2 class="text-[clamp(28px,3vw,38px)] font-medium leading-tight tracking-tight">
          Have a challenge we should understand?
        </h2>
        <p class="mt-4 max-w-[650px] text-[14px] leading-[1.8] text-silver-400">
          We’d love to hear from growers, engineers, and mentors who can help turn a promising idea into a
          useful first build.
        </p>
      </div>
      <a class="btn btn-light shrink-0 self-start md:self-auto" href={`${home}#growers`}>
        Let’s talk <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</Layout>
