---
import { Image } from 'astro:assets';
import GalleryButton from '../GalleryButton.astro';
import cover from '../../assets/photos/team-cover.jpg';
import { site, url } from '../../data/site';

const coverAlt = 'The SPAIS community together in front of the society’s presentation screen.';
---

<!-- The headline sits above the photo so it never competes with the
     presentation screen or the faces in the team cover. -->
<section class="relative isolate overflow-hidden bg-deep text-white" aria-labelledby="hero-title">
  <div
    class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[520px] bg-[radial-gradient(60%_80%_at_50%_0%,#2a313b_0%,transparent_70%)]"
    aria-hidden="true"
  >
  </div>

  <div class="wrap pb-10 pt-14 md:pb-14 md:pt-20">
    <div class="grid items-end gap-10 lg:grid-cols-[1.25fr_1fr] lg:gap-16">
      <div data-reveal>
        <p class="mb-6 text-[10px] font-medium uppercase tracking-[0.2em] text-silver-400 md:text-[11px]">
          {site.fullName} · {site.university}
        </p>
        <h1 id="hero-title" class="display-xl text-white">
          Bringing AI into<br />the real world.
        </h1>
        <p class="mt-5 text-[17px] text-silver-300 md:text-lg">For a sustainable future.</p>
      </div>

      <div class="lg:pb-2" data-reveal style="--reveal-delay:150ms">
        <p class="mb-6 max-w-[420px] text-[15px] leading-relaxed text-silver-400">
          A student-led community building physical AI with purpose: from the lab, to the field.
        </p>
        <div class="flex flex-col gap-3 sm:flex-row">
          <a class="btn btn-light" href={`${url()}#join`} data-join-tab="students">Join the team <span aria-hidden="true">→</span></a>
          <a class="btn btn-glass" href={url('project')}>Explore our project <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </div>
  </div>

  <div class="px-3 pb-3 md:px-5 md:pb-5">
    <div class="relative overflow-hidden rounded-2xl md:rounded-3xl">
      <Image
        src={cover}
        alt={coverAlt}
        widths={[640, 960, 1280, 1600, 2048]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        class="aspect-[4/3] w-full object-cover object-[center_60%] sm:aspect-[16/9] lg:aspect-[21/9]"
      />
      <div
        class="pointer-events-none absolute inset-x-0 bottom-0 h-32 bg-gradient-to-t from-black/60 to-transparent"
        aria-hidden="true"
      >
      </div>
      <p class="absolute bottom-5 left-5 text-[11px] tracking-wide text-white/80 md:bottom-7 md:left-8 md:text-xs">
        Curiosity connects us. Purpose moves us.
      </p>
      <GalleryButton
        title="The SPAIS community"
        photos={[{ src: cover, alt: 'SPAIS members and guests together in front of the society’s presentation screen.' }]}
        label="View the full SPAIS team photo"
        class="!absolute bottom-3 right-3 !w-auto rounded-full bg-black/30 px-3 py-2 text-[11px] text-white/90 backdrop-blur-md transition-colors hover:bg-black/50 md:bottom-5 md:right-6"
      >
        <span class="flex items-center gap-2">
          <svg viewBox="0 0 20 20" fill="none" class="size-4" aria-hidden="true"><path d="M4 7V4h3m6 0h3v3M4 13v3h3m6 0h3v-3" stroke="currentColor" stroke-width="1.4"></path></svg>
          <span class="hidden sm:inline">View photo</span>
        </span>
      </GalleryButton>
    </div>
  </div>
</section>
