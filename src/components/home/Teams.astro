---
import { teams } from '../../data/site';

// Line icons from the original draft, keyed by team.icon.
const icons: Record<string, string> = {
  cube: '<path d="m16 4 10 6v12l-10 6-10-6V10l10-6Zm0 12 10-6M16 16 6 10M16 16v12" stroke="currentColor" stroke-width="1.5"/>',
  chip: '<rect x="9" y="9" width="14" height="14" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M13 4v5m6-5v5M13 23v5m6-5v5M4 13h5m-5 6h5m14-6h5m-5 6h5" stroke="currentColor" stroke-width="1.5"/><path d="m17 12-4 5h5l-3 4" stroke="currentColor" stroke-width="1.5"/>',
  eye: '<path d="M3 16s5-9 13-9 13 9 13 9-5 9-13 9S3 16 3 16Z" stroke="currentColor" stroke-width="1.5"/><circle cx="16" cy="16" r="4" stroke="currentColor" stroke-width="1.5"/>',
  nav: '<path d="m26 5-7 22-4-10-10-4L26 5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="m15 17 11-12" stroke="currentColor" stroke-width="1.5"/>',
};
---

<section id="teams" class="bg-white py-24 md:py-32" aria-labelledby="teams-title">
  <div class="wrap">
    <div class="mb-12 flex flex-col justify-between gap-6 md:flex-row md:items-end" data-reveal>
      <div>
        <p class="eyebrow">03 / Our teams</p>
        <h2 id="teams-title" class="display-lg">Find your team.</h2>
      </div>
      <p class="max-w-[360px] text-[14px] leading-[1.8] text-muted">
        Four disciplines. One shared build.<br />Discover where your curiosity could take you.
      </p>
    </div>

    <div class="grid gap-4 md:grid-cols-2">
      {
        teams.map((team, i) => (
          <details
            class="team-card group rounded-xl border border-line bg-white p-6 transition-[border-color,box-shadow] duration-300 hover:border-silver-300 open:border-silver-300 open:shadow-[0_12px_40px_-20px_#0003] md:p-7"
            data-reveal
            style={`--reveal-delay:${i * 80}ms`}
          >
            <summary class="grid cursor-pointer list-none grid-cols-[40px_1fr_28px] items-center gap-4 [&::-webkit-details-marker]:hidden">
              <span class="grid size-10 place-items-center rounded-lg bg-pale text-silver-600">
                <svg viewBox="0 0 32 32" fill="none" class="size-6" aria-hidden="true" set:html={icons[team.icon]} />
              </span>
              <span>
                <h3 class="text-[18px] font-semibold tracking-[-0.01em] md:text-[19px]">{team.name}</h3>
                <span class="mt-1 block text-[13px] text-silver-500">{team.short}</span>
              </span>
              <span
                class="grid size-7 place-items-center rounded-full border border-line text-lg font-light text-silver-600 transition-transform duration-300 group-open:rotate-45"
                aria-hidden="true"
              >
                +
              </span>
            </summary>
            <div class="pl-0 pt-5 sm:pl-14">
              <p class="text-[14px] leading-[1.85] text-muted">{team.body}</p>
              <ul class="mt-5 flex flex-wrap gap-2">
                {team.tags.map((tag) => (
                  <li class="rounded-full border border-line bg-silver-50 px-3 py-1 text-[11px] text-silver-700">{tag}</li>
                ))}
              </ul>
              <a
                href="#join"
                data-join-tab="students"
                class="mt-5 inline-block text-[12px] font-medium underline underline-offset-[5px] hover:opacity-60"
              >
                {team.cta} ↗
              </a>
            </div>
          </details>
        ))
      }
    </div>

    <div
      class="mt-8 flex flex-col justify-between gap-4 rounded-xl bg-pale px-6 py-5 sm:flex-row sm:items-center"
      data-reveal
    >
      <p class="text-[13px] text-muted">
        <strong class="font-semibold text-ink">New to robotics?</strong> You’re welcome here. There’s room to learn, ask questions,
        and start small.
      </p>
      <a class="text-link shrink-0 text-[12px]" href="#join" data-join-tab="students">
        Meet your next team <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>
