---
import { Image } from 'astro:assets';
import concept from '../../assets/platform-concept.svg';
import { url } from '../../data/site';
---

<section id="project" class="bg-pale py-24 md:py-32" aria-labelledby="project-title">
  <div class="wrap grid items-center gap-x-16 gap-y-12 lg:grid-cols-[0.88fr_1.12fr]">
    <div data-reveal>
      <p class="eyebrow">02 / Our first engineering project</p>
      <h2 id="project-title" class="display-lg">From the lab.<br />To the field.</h2>
      <p class="mt-7 max-w-[440px] text-[15px] leading-[1.9] text-muted">
        A compact, modular mobile robot for precision crop care. We’re starting with growers’ experience and a carefully
        defined task.
      </p>
      <span class="pill mt-7 bg-white"><span class="dot"></span>Discovery & concept development</span>
      <dl class="my-8 flex flex-wrap gap-x-10 gap-y-4">
        <div>
          <dt class="text-[10px] uppercase tracking-[0.12em] text-silver-500">Current focus</dt>
          <dd class="mt-1.5 text-[13px] text-ink">Farm needs & platform design</dd>
        </div>
        <div>
          <dt class="text-[10px] uppercase tracking-[0.12em] text-silver-500">Under study</dt>
          <dd class="mt-1.5 text-[13px] text-ink">Greenhouse crop care</dd>
        </div>
      </dl>
      <a class="btn btn-dark" href={url('project')}>Explore the project <span aria-hidden="true">↗</span></a>
    </div>

    <figure
      class="relative overflow-hidden rounded-xl bg-[#e8ebee] ring-1 ring-black/5"
      data-reveal
      style="--reveal-delay:120ms"
    >
      <span class="absolute left-5 top-5 text-[10px] tracking-[0.12em] text-silver-600">MODULAR PLATFORM / 001</span>
      <Image
        src={concept}
        alt="Concept illustration of a mobile robot with a camera and interchangeable task module beside a plant."
        class="h-auto w-full"
      />
      <figcaption class="absolute inset-x-5 bottom-4 text-[10px] text-silver-500">
        Illustrative concept · Proposed architecture
      </figcaption>
    </figure>

    <div
      class="flex flex-col justify-between gap-4 border-t border-silver-200 pt-6 sm:flex-row sm:items-start lg:col-span-2"
      data-reveal
    >
      <p class="max-w-[620px] text-[12px] leading-[1.8] text-muted">
        Our goal is a useful, testable prototype. Field performance and crop-care benefits are still to be validated.
      </p>
      <a href="#join" data-join-tab="growers" class="whitespace-nowrap text-[12px] font-medium hover:underline">
        Help shape the project <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>
