---
import { site, mailto } from '../../data/site';

const panels = [
  {
    id: 'students',
    tab: 'Students',
    title: 'Bring your curiosity.',
    body: 'Whether you want to build a robot, explore an idea, or learn alongside people from other disciplines, you’re welcome to join us.',
    points: [
      'Meet the four technical teams',
      'Find a starting point that fits your interests',
      'Join conversations, visits, and hands-on learning',
    ],
    cta: 'Join us on Discord',
    href: site.links.discord,
    external: true,
    hint: 'Prefer email? Introduce yourself at the address below.',
  },
  {
    id: 'growers',
    tab: 'Growers',
    title: 'Your experience shapes the build.',
    body: 'We’re looking to learn from growers about repetitive tasks, practical constraints, and what useful automation would look like on their farm.',
    points: [
      'Share your crop-care workflow and challenges',
      'Help us review an early concept',
      'Explore a future supervised prototype trial',
    ],
    cta: 'Talk with our team',
    href: mailto.growers,
    external: false,
    hint: 'Opens a draft in your email app.',
  },
  {
    id: 'partners',
    tab: 'Industry & mentors',
    title: 'Help the next idea take shape.',
    body: 'Connect students with practical engineering experience. We welcome conversations about mentorship, equipment, and support for our first prototype.',
    points: [
      'Offer a technical workshop or design review',
      'Contribute components, fabrication, or equipment access',
      'Discuss sponsorship for student-led development',
    ],
    cta: 'Explore a collaboration',
    href: mailto.partners,
    external: false,
    hint: 'Opens a draft in your email app.',
  },
];
---

<section id="join" class="relative bg-deep py-24 text-white md:py-32" aria-labelledby="join-title">
  <!-- Native scroll targets for /#growers and /#partners deep links. -->
  <span id="growers" class="absolute top-0" aria-hidden="true"></span>
  <span id="partners" class="absolute top-0" aria-hidden="true"></span>
  <div class="wrap grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-28">
    <div data-reveal>
      <p class="eyebrow !text-silver-400">Build something that matters</p>
      <h2 id="join-title" class="display-lg">There’s a place<br />for you here.</h2>
      <p class="mt-8 max-w-[420px] text-[15px] leading-[1.9] text-silver-400">
        Great projects start with people willing to share a question, an experience, or a little of their time. Let’s
        start a conversation.
      </p>
    </div>

    <div data-reveal style="--reveal-delay:120ms">
      <div
        class="join-tabs mb-8 flex gap-1 overflow-x-auto rounded-full border border-white/10 bg-white/[0.03] p-1"
        role="tablist"
        aria-label="Ways to get involved"
      >
        {
          panels.map((p, i) => (
            <button
              id={`tab-${p.id}`}
              role="tab"
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-controls={`panel-${p.id}`}
              tabindex={i === 0 ? 0 : -1}
              class="flex-1 whitespace-nowrap rounded-full px-4 py-2.5 text-[12px] text-silver-400 transition-colors hover:text-white aria-selected:bg-white aria-selected:text-ink"
            >
              {p.tab}
            </button>
          ))
        }
      </div>

      {
        panels.map((p, i) => (
          <div id={`panel-${p.id}`} role="tabpanel" aria-labelledby={`tab-${p.id}`} tabindex="0" hidden={i !== 0}>
            <h3 class="text-[24px] font-medium leading-[1.35] text-silver-50 md:text-[26px]">{p.title}</h3>
            <p class="mt-4 text-[14px] leading-[1.85] text-silver-400">{p.body}</p>
            <ul class="my-7 space-y-3">
              {p.points.map((pt) => (
                <li class="relative pl-6 text-[13px] text-silver-300">
                  <span class="absolute left-0 text-silver-500" aria-hidden="true">↗</span>
                  {pt}
                </li>
              ))}
            </ul>
            <a
              class="btn btn-light"
              href={p.href}
              {...(p.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              {p.cta} <span aria-hidden="true">↗</span>
            </a>
            <p class="mt-3 text-[11px] text-silver-500">{p.hint}</p>
          </div>
        ))
      }

      <div class="mt-8 flex flex-wrap items-center gap-4 border-t border-white/10 pt-6">
        <a href={`mailto:${site.email}`} class="text-[13px] text-silver-200 hover:text-white">{site.email}</a>
        <button
          class="copy-btn border-b border-silver-600 py-1 text-[11px] text-silver-400 hover:text-white"
          aria-label="Copy SPAIS email address"
          data-email={site.email}>Copy email</button
        >
        <span class="copy-status text-[11px] text-accent" role="status" aria-live="polite"></span>
      </div>
    </div>
  </div>
</section>

<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('#join [role="tab"]')];

  function activate(tab: HTMLButtonElement, focus = false) {
    for (const t of tabs) {
      const active = t === tab;
      t.setAttribute('aria-selected', String(active));
      t.tabIndex = active ? 0 : -1;
      document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !active;
    }
    if (focus) tab.focus();
  }

  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => activate(tab));
    tab.addEventListener('keydown', (e) => {
      const keys: Record<string, number> = {
        ArrowRight: (i + 1) % tabs.length,
        ArrowLeft: (i - 1 + tabs.length) % tabs.length,
        Home: 0,
        End: tabs.length - 1,
      };
      if (!(e.key in keys)) return;
      e.preventDefault();
      activate(tabs[keys[e.key]], true);
    });
  });

  // Links elsewhere on the page can preselect a tab.
  document.querySelectorAll<HTMLElement>('[data-join-tab]').forEach((link) =>
    link.addEventListener('click', () => {
      const t = document.getElementById(`tab-${link.dataset.joinTab}`) as HTMLButtonElement | null;
      if (t) activate(t);
    }),
  );

  // Deep links such as /#growers or /#partners (used by the project page).
  const fromHash = location.hash.slice(1);
  if (fromHash === 'growers' || fromHash === 'partners') {
    const t = document.getElementById(`tab-${fromHash}`) as HTMLButtonElement | null;
    if (t) activate(t);
  }

  const copy = document.querySelector<HTMLButtonElement>('.copy-btn');
  const status = document.querySelector('.copy-status');
  copy?.addEventListener('click', async () => {
    const email = copy.dataset.email!;
    try {
      await navigator.clipboard.writeText(email);
      status!.textContent = 'Email copied';
      copy.textContent = 'Copied ✓';
      setTimeout(() => {
        status!.textContent = '';
        copy.textContent = 'Copy email';
      }, 3000);
    } catch {
      status!.textContent = `Email: ${email}`;
    }
  });
</script>
