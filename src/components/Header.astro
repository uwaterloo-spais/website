---
import { Image } from 'astro:assets';
import wordmark from '../assets/brand/spais-wordmark-black.png';
import { url } from '../data/site';

interface Props {
  current: 'home' | 'project';
}
const { current } = Astro.props;

const home = url();
const links = [
  { label: 'Mission', href: `${home}#about` },
  { label: 'Our project', href: url('project'), page: 'project' },
  { label: 'Teams', href: `${home}#teams` },
  { label: 'Community', href: `${home}#updates` },
];
---

<header
  class="sticky top-0 z-40 border-b border-black/[0.06] bg-white/85 backdrop-blur-xl backdrop-saturate-150"
>
  <div class="flex h-16 items-center justify-between gap-8 px-6 md:h-[72px] md:px-10 xl:px-12">
    <a href={home} class="flex shrink-0 items-center gap-5" aria-label="SPAIS home">
      <Image src={wordmark} alt="SPAIS" width={120} class="h-auto w-[104px] md:w-[120px]" loading="eager" />
      <span
        class="hidden border-l border-silver-200 pl-5 text-[9px] font-medium uppercase leading-[1.5] tracking-[0.14em] text-silver-600 sm:block"
      >Sustainable<br />Physical AI Society</span>
    </a>

    <button
      class="menu-button flex size-11 flex-col items-center justify-center gap-[5px] md:hidden"
      aria-expanded="false"
      aria-controls="main-nav"
      aria-label="Open navigation"
    >
      <span class="h-[1.5px] w-5 bg-ink transition-transform"></span>
      <span class="h-[1.5px] w-5 bg-ink transition-transform"></span>
    </button>

    <nav
      id="main-nav"
      aria-label="Main navigation"
      class="nav-links absolute inset-x-0 top-16 hidden flex-col gap-1 border-b border-line bg-white p-6 text-[15px] font-medium shadow-[0_18px_25px_#0000000d] md:static md:flex md:flex-row md:items-center md:gap-8 md:border-0 md:bg-transparent md:p-0 md:text-[13px] md:shadow-none"
    >
      {
        links.map((l) => (
          <a
            href={l.href}
            aria-current={l.page === current ? 'page' : undefined}
            class="py-2 text-ink/80 transition-colors hover:text-ink aria-[current=page]:text-ink aria-[current=page]:underline aria-[current=page]:underline-offset-8"
          >
            {l.label}
          </a>
        ))
      }
      <a href={`${home}#join`} class="btn btn-dark mt-3 min-h-10 px-5 text-[12px] md:mt-0">
        Get involved <span aria-hidden="true">↗</span>
      </a>
    </nav>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('.menu-button');
  const nav = document.querySelector<HTMLElement>('.nav-links');
  const setOpen = (open: boolean) => {
    if (!button || !nav) return;
    button.setAttribute('aria-expanded', String(open));
    button.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
    nav.classList.toggle('hidden', !open);
    nav.classList.toggle('flex', open);
    const [a, b] = button.querySelectorAll('span');
    a.style.transform = open ? 'translateY(3.25px) rotate(45deg)' : '';
    b.style.transform = open ? 'translateY(-3.25px) rotate(-45deg)' : '';
  };
  button?.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
  nav?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
</script>
