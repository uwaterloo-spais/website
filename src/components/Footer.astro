---
import { Image } from 'astro:assets';
import wordmark from '../assets/brand/spais-wordmark-white.png';
import { site, url } from '../data/site';

interface Props {
  note?: { label: string; href: string };
}
const { note = { label: 'Learn. Build. Make it matter.', href: `${url()}#join` } } = Astro.props;

const socials = [
  { label: 'LinkedIn', href: site.links.linkedin },
  { label: 'Instagram', href: site.links.instagram },
  { label: 'Discord', href: site.links.discord },
  { label: 'GitHub', href: site.links.github },
  { label: 'Email', href: `mailto:${site.email}` },
];
---

<footer class="bg-deep pb-8 pt-16 text-white">
  <div class="wrap">
    <div class="flex flex-col justify-between gap-10 md:flex-row md:items-end">
      <a href={url()} class="block" aria-label="SPAIS home">
        <Image src={wordmark} alt="SPAIS" width={200} class="h-auto w-[170px] md:w-[200px]" />
        <span class="mt-4 block text-[10px] uppercase tracking-[0.16em] text-silver-400">
          {site.fullName} · {site.university}
        </span>
      </a>
      <ul class="flex flex-wrap gap-x-7 gap-y-3 text-[13px] text-silver-300">
        {
          socials.map((s) => (
            <li>
              <a
                href={s.href}
                class="transition-colors hover:text-white"
                {...(s.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              >
                {s.label} <span aria-hidden="true">↗</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div
      class="mt-12 flex flex-col justify-between gap-2 border-t border-white/10 pt-6 text-[11px] text-silver-500 sm:flex-row"
    >
      <p class="text-silver-500">© {new Date().getFullYear()} SPAIS · A student-led community at the University of Waterloo.</p>
      <a href={note.href} class="hover:text-silver-300">{note.label} ↗</a>
    </div>
  </div>
</footer>
