---
// One shared photo lightbox per page. Open it with <GalleryButton>, which
// stores the album (optimized image URLs + alt text) in a data attribute.
---

<dialog
  class="gallery-dialog m-auto w-[min(1100px,94vw)] overflow-hidden rounded-xl border border-white/10 bg-coal p-0 text-white shadow-[0_30px_100px_#000a] backdrop:bg-black/85 backdrop:backdrop-blur-sm"
  aria-labelledby="gallery-title"
>
  <div class="flex items-center justify-between gap-5 px-5 py-4">
    <p id="gallery-title" class="gallery-title text-[13px] text-silver-200">Community photos</p>
    <button
      class="gallery-close grid size-9 place-items-center rounded-full border border-white/15 text-xl hover:bg-white/10"
      aria-label="Close photo gallery">×</button
    >
  </div>
  <div class="bg-black">
    <img class="gallery-image h-[min(65vh,700px)] w-full object-contain" alt="" />
  </div>
  <div class="flex items-center justify-between gap-4 px-5 py-4">
    <span class="gallery-count text-[12px] text-silver-400" aria-live="polite"></span>
    <a
      class="gallery-source text-[12px] text-silver-300 hover:text-white"
      target="_blank"
      rel="noopener noreferrer">View original post ↗</a
    >
    <div class="flex gap-2">
      <button
        data-prev
        class="h-9 w-11 rounded-full border border-white/15 hover:bg-white/10 disabled:opacity-30"
        aria-label="Previous photo">←</button
      >
      <button
        data-next
        class="h-9 w-11 rounded-full border border-white/15 hover:bg-white/10 disabled:opacity-30"
        aria-label="Next photo">→</button
      >
    </div>
  </div>
</dialog>

<script>
  type Album = { title: string; source?: string; photos: { src: string; alt: string }[] };

  const dialog = document.querySelector<HTMLDialogElement>('.gallery-dialog');
  if (dialog) {
    const img = dialog.querySelector<HTMLImageElement>('.gallery-image')!;
    const title = dialog.querySelector('.gallery-title')!;
    const count = dialog.querySelector('.gallery-count')!;
    const source = dialog.querySelector<HTMLAnchorElement>('.gallery-source')!;
    const prev = dialog.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = dialog.querySelector<HTMLButtonElement>('[data-next]')!;
    let album: Album | undefined;
    let index = 0;
    let returnFocus: HTMLElement | null = null;

    const render = () => {
      if (!album) return;
      const photo = album.photos[index];
      img.src = photo.src;
      img.alt = photo.alt;
      title.textContent = album.title;
      count.textContent = `${index + 1} / ${album.photos.length}`;
      source.hidden = !album.source;
      if (album.source) source.href = album.source;
      prev.disabled = next.disabled = album.photos.length < 2;
    };
    const step = (n: number) => {
      if (!album) return;
      index = (index + n + album.photos.length) % album.photos.length;
      render();
    };

    document.querySelectorAll<HTMLElement>('[data-album]').forEach((trigger) =>
      trigger.addEventListener('click', () => {
        album = JSON.parse(trigger.dataset.album!);
        index = Number(trigger.dataset.photo ?? 0);
        returnFocus = trigger;
        render();
        dialog.showModal();
        document.body.style.overflow = 'hidden';
      }),
    );
    dialog.querySelector('.gallery-close')!.addEventListener('click', () => dialog.close());
    prev.addEventListener('click', () => step(-1));
    next.addEventListener('click', () => step(1));
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); step(1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); step(-1); }
    });
    dialog.addEventListener('click', (e) => {
      if (e.target !== dialog) return;
      const r = dialog.getBoundingClientRect();
      if (e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom) dialog.close();
    });
    dialog.addEventListener('close', () => {
      document.body.style.overflow = '';
      returnFocus?.focus();
    });
  }
</script>
