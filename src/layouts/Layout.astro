---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GalleryDialog from '../components/GalleryDialog.astro';
import { site, url } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Absolute or root-relative path to the social share image. */
  image?: string;
  /** Which nav item to mark as current. */
  current?: 'home' | 'project';
  footerNote?: { label: string; href: string };
}

const {
  title = `${site.name} — Bringing AI into the real world`,
  description = site.description,
  image,
  current = 'home',
  footerNote,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site) : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0c0d0e" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={url('favicon.png')} />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`${site.name} — ${site.fullName}`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a
      href="#main"
      class="fixed -top-20 left-4 z-[100] rounded bg-white px-4 py-2 text-ink focus:top-3"
    >Skip to content</a>
    <Header current={current} />
    <main id="main">
      <slot />
    </main>
    <Footer note={footerNote} />
    <GalleryDialog />

    <script>
      // Reveal [data-reveal] elements as they scroll into view.
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          }
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
